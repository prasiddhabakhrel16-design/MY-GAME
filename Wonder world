      <label for="nickname">What should we call you?</label>
      <input class="field" id="nickname" maxlength="35" placeholder="Your nickname">
      <label for="message">Leave a message for your future self.</label>
      <textarea class="field" id="message" maxlength="500" placeholder="Write something kind, funny, or wonderfully weird..."></textarea>
