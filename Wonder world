
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WonderLab — Explore the Weird</title>

<style>
:root {
  --bg: #f6f5f1;
  --card: #ffffff;
  --ink: #202020;
  --muted: #737373;
  --line: #e6e4df;
  --accent: #7357ff;
  --soft: #eeeaff;
  --shadow: 0 8px 30px #2020200b;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: Arial, Helvetica, sans-serif;
  transition: background .25s, color .25s;
}
body.dark {
  --bg: #17171d;
  --card: #24242d;
  --ink: #f4f2ff;
  --muted: #b1afbd;
  --line: #393945;
  --soft: #37304f;
  --shadow: 0 8px 30px #0003;
}
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible,
textarea:focus-visible, a:focus-visible {
  outline: 3px solid #a99aff;
  outline-offset: 3px;
}
a { color: inherit; }
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--card);
  border-bottom: 1px solid var(--line);
  padding: 13px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.logo { font-size: 21px; font-weight: 900; letter-spacing: -1px; }
.logo span { color: var(--accent); }
.nav { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.nav a, .nav button {
  text-decoration: none;
  border: 0;
  background: transparent;
  color: var(--ink);
  padding: 8px;
  border-radius: 10px;
  font-size: 13px;
}
.nav a:hover, .nav button:hover { background: var(--soft); }
.wrap { width: min(1080px, 91%); margin: auto; }
.hero {
  padding: 65px 0 42px;
  text-align: center;
}
.eyebrow {
  display: inline-block;
  background: var(--soft);
  color: var(--accent);
  border-radius: 50px;
  padding: 8px 13px;
  font-weight: bold;
  font-size: 12px;
  letter-spacing: 1px;
}
.hero h1 {
  font-size: clamp(44px, 9vw, 86px);
  letter-spacing: -5px;
  line-height: .98;
  margin: 22px 0 18px;
}
.gradient {
  background: linear-gradient(100deg, #7657ff, #ff6398, #ffad52);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero p {
  max-width: 550px;
  margin: auto;
  color: var(--muted);
  line-height: 1.7;
  font-size: 17px;
}
.search {
  display: block;
  width: min(480px, 100%);
  margin: 27px auto 0;
  padding: 15px 18px;
  border: 1px solid var(--line);
  background: var(--card);
  color: var(--ink);
  border-radius: 15px;
}
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 30px 0 40px;
}
.stat {
  text-align: center;
  padding: 20px 8px;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 17px;
}
.stat strong { display: block; font-size: 26px; }
.stat span { font-size: 12px; color: var(--muted); }
.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 10px;
  margin: 42px 0 18px;
}
.section-heading h2 { margin: 0; font-size: 28px; letter-spacing: -1px; }
.section-heading p { margin: 6px 0 0; color: var(--muted); font-size: 14px; }
.pill {
  border: 1px solid var(--line);
  background: var(--card);
  color: var(--ink);
  padding: 8px 12px;
  border-radius: 50px;
  font-size: 12px;
}
.pill.active { background: var(--ink); color: var(--bg); }
.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
}
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 21px;
  box-shadow: var(--shadow);
  min-width: 0;
}
.experiment {
  text-align: left;
  color: var(--ink);
  width: 100%;
  min-height: 190px;
  transition: transform .18s, border-color .18s;
}
.experiment:hover { transform: translateY(-4px); border-color: #a99aff; }
.emoji { font-size: 34px; display: block; margin-bottom: 17px; }
.experiment h3 { font-size: 18px; margin: 0 0 8px; }
.experiment p { color: var(--muted); font-size: 13px; line-height: 1.55; margin: 0; }
.tag {
  display: inline-block;
  margin-top: 14px;
  color: var(--accent);
  font-size: 11px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: .7px;
}
.panel { margin-top: 30px; scroll-margin-top: 90px; }
.panel h2 { letter-spacing: -1px; }
.panel p { color: var(--muted); line-height: 1.6; }
.tool { padding: 26px; }
.big-number { font-size: clamp(32px, 7vw, 58px); font-weight: 900; letter-spacing: -2px; }
.muted { color: var(--muted); font-size: 13px; }
.btn {
  background: var(--ink);
  color: var(--bg);
  border: 0;
  border-radius: 12px;
  padding: 12px 17px;
  font-weight: bold;
  margin: 4px 3px 4px 0;
}
.btn.primary { background: var(--accent); color: white; }
.btn.light { background: var(--soft); color: var(--ink); }
.field {
  width: 100%;
  border: 1px solid var(--line);
  background: var(--bg);
  color: var(--ink);
  padding: 13px;
  border-radius: 12px;
  margin: 6px 0 12px;
}
textarea.field { min-height: 100px; resize: vertical; }
.rowline { display: flex; gap: 9px; align-items: center; flex-wrap: wrap; }
.rowline .field { flex: 1; min-width: 100px; }
.result {
  margin-top: 14px;
  padding: 14px;
  border-radius: 13px;
  background: var(--soft);
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.meter {
  height: 14px;
  background: var(--line);
  border-radius: 20px;
  overflow: hidden;
  margin: 14px 0;
}
.meter div {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #7657ff, #ff6398);
  transition: width .2s;
}
.color-box {
  height: 130px;
  border-radius: 16px;
  background: #7357ff;
  margin: 15px 0;
  border: 1px solid var(--line);
}
.planet {
  display: inline-grid;
  place-items: center;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  font-size: 32px;
  background: var(--soft);
  margin: 4px;
  cursor: pointer;
  border: 2px solid transparent;
}
.planet.selected { border-color: var(--accent); }
.shop-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}
.shop-item {
  border: 1px solid var(--line);
  background: var(--bg);
  color: var(--ink);
  border-radius: 14px;
  padding: 14px;
  text-align: left;
}
.shop-item strong { display: block; margin: 7px 0; }
.shop-item small { color: var(--muted); }
.task {
  display: flex;
  gap: 9px;
  align-items: center;
  padding: 11px 0;
  border-bottom: 1px solid var(--line);
  overflow-wrap: anywhere;
}
.task span { flex: 1; }
.task.done span { text-decoration: line-through; color: var(--muted); }
.task button {
  background: transparent;
  border: 0;
  color: var(--muted);
  padding: 8px;
}
footer {
  text-align: center;
  color: var(--muted);
  padding: 60px 10px 35px;
  font-size: 13px;
}
.hidden { display: none !important; }
#toast {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--ink);
  color: var(--bg);
  padding: 13px 18px;
  border-radius: 12px;
  z-index: 20;
  box-shadow: var(--shadow);
  max-width: 90%;
  text-align: center;
}
@media (max-width: 750px) {
  .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hero { padding-top: 45px; }
  .hero h1 { letter-spacing: -3px; }
  .nav a { display: none; }
}
@media (max-width: 430px) {
  .grid { grid-template-columns: 1fr; }
  .experiment { min-height: 0; }
  .stats { gap: 7px; }
  .stat strong { font-size: 22px; }
  .card { padding: 18px; }
  .tool { padding: 20px; }
}
</style>
</head>

<body>
<header class="topbar">
  <div class="logo">wonder<span>lab</span> ✳</div>
  <nav class="nav">
    <a href="#explore">Explore</a>
    <a href="#play">Play</a>
    <a href="#create">Create</a>
    <button onclick="toggleDark()" id="themeBtn">🌙 Theme</button>
  </nav>
</header>

<main class="wrap">
  <section class="hero">
    <span class="eyebrow">THE INTERNET PLAYGROUND ✨</span>
    <h1>Curiosity<br>looks good <span class="gradient">on you.</span></h1>
    <p>A collection of tiny experiments, ridiculous games, curious facts, and things you didn't know you needed to click.</p>
    <input class="search" id="search" placeholder="🔎 Find something interesting..." oninput="filterCards()">
  </section>

  <div class="stats">
    <div class="stat"><strong id="visitCount">0</strong><span>Experiments available</span></div>
    <div class="stat"><strong id="clickCount">0</strong><span>Things you've clicked</span></div>
    <div class="stat"><strong>∞</strong><span>Ways to get distracted</span></div>
  </div>

  <section id="explore">
    <div class="section-heading">
      <div>
        <h2>Pick your rabbit hole.</h2>
        <p>One little click can lead anywhere.</p>
      </div>
    </div>
    <div class="rowline" style="margin-bottom:16px">
      <button class="pill active" onclick="setCategory('all',this)">Everything</button>
      <button class="pill" onclick="setCategory('play',this)">🎮 Games</button>
      <button class="pill" onclick="setCategory('learn',this)">🧠 Learn</button>
      <button class="pill" onclick="setCategory('create',this)">🎨 Create</button>
    </div>

    <div class="grid" id="experimentGrid">
      <button class="card experiment" data-category="learn" onclick="openTool('universe')">
        <span class="emoji">🪐</span><h3>Little Universe</h3>
        <p>Visit strange worlds and learn a few space facts.</p><span class="tag">Explore space ↗</span>
      </button>
      <button class="card experiment" data-category="play" onclick="openTool('money')">
        <span class="emoji">💸</span><h3>Spend a Fortune</h3>
        <p>Can you spend your pretend fortune without going broke?</p><span class="tag">Shopping simulator ↗</span>
      </button>
      <button class="card experiment" data-category="learn" onclick="openTool('earth')">
        <span class="emoji">🌍</span><h3>Planet Earth</h3>
        <p>Explore some fascinating facts about our home.</p><span class="tag">Our world ↗</span>
      </button>
      <button class="card experiment" data-category="create" onclick="openTool('colors')">
        <span class="emoji">🎨</span><h3>Color Lab</h3>
        <p>Mix RGB colors and create your own digital shade.</p><span class="tag">Make a color ↗</span>
      </button>
      <button class="card experiment" data-category="learn" onclick="openTool('facts')">
        <span class="emoji">🤯</span><h3>Fact Machine</h3>
        <p>Press a button and discover something surprising.</p><span class="tag">Random knowledge ↗</span>
      </button>
      <button class="card experiment" data-category="play" onclick="openTool('reaction')">
        <span class="emoji">⚡</span><h3>Reaction Test</h3>
        <p>Test how quickly you can react to a signal.</p><span class="tag">Ready, set, tap ↗</span>
      </button>
      <button class="card experiment" data-category="play" onclick="openTool('guess')">
        <span class="emoji">🔢</span><h3>Guess the Number</h3>
        <p>A secret number is hiding between 1 and 100.</p><span class="tag">Can you find it? ↗</span>
      </button>
      <button class="card experiment" data-category="create" onclick="openTool('story')">
        <span class="emoji">✍️</span><h3>Story Machine</h3>
        <p>Generate a wonderfully weird story idea.</p><span class="tag">Get creative ↗</span>
      </button>
      <button class="card experiment" data-category="create" onclick="openTool('todo')">
        <span class="emoji">📝</span><h3>Future Me</h3>
        <p>Make a little list of things you want to do.</p><span class="tag">Plan something ↗</span>
      </button>
      <button class="card experiment" data-category="play" onclick="openTool('coin')">
        <span class="emoji">🪙</span><h3>Coin of Destiny</h3>
        <p>Heads or tails? Let the universe decide.</p><span class="tag">Flip it ↗</span>
      </button>
      <button class="card experiment" data-category="play" onclick="openTool('clicker')">
        <span class="emoji">🖱️</span><h3>Button Madness</h3>
        <p>How many times can you tap in ten seconds?</p><span class="tag">Tap like crazy ↗</span>
      </button>
      <button class="card experiment" data-category="create" onclick="openTool('fortune')">
        <span class="emoji">🔮</span><h3>Fortune Cookie</h3>
        <p>Receive a mysterious message from the future.</p><span class="tag">Reveal destiny ↗</span>
      </button>
    </div>
    <p class="muted hidden" id="noResults">Nothing found. Try another search!</p>
  </section>

  <!-- SPACE EXPLORER -->
  <section class="panel hidden" id="tool-universe">
    <div class="section-heading"><div><h2>🪐 Little Universe</h2><p>Choose a cosmic destination.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <div class="rowline" id="planetButtons">
        <button class="planet selected" onclick="planet('Earth',this)">🌍</button>
        <button class="planet" onclick="planet('Mars',this)">🔴</button>
        <button class="planet" onclick="planet('Jupiter',this)">🟠</button>
        <button class="planet" onclick="planet('Saturn',this)">🪐</button>
        <button class="planet" onclick="planet('Neptune',this)">🔵</button>
      </div>
      <div class="result" id="planetInfo"><h3>Earth</h3>Our home planet has liquid water on its surface and supports an extraordinary variety of life.</div>
      <p class="muted">Tap any planet symbol to explore. The illustrations are playful symbols, not scale models.</p>
    </div>
  </section>

  <!-- MONEY GAME -->
  <section class="panel hidden" id="tool-money">
    <div class="section-heading"><div><h2>💸 Spend a Fortune</h2><p>All money here is imaginary!</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <p>Your imaginary balance</p>
      <div class="big-number" id="balance">$1,000,000</div>
      <div class="meter"><div id="moneyMeter"></div></div>
      <div class="shop-grid" id="shopGrid"></div>
      <button class="btn light" onclick="resetMoney()">Start over ↻</button>
      <div class="result" id="moneyMessage">You have one million pretend dollars. What will you buy?</div>
    </div>
  </section>

  <!-- EARTH FACTS -->
  <section class="panel hidden" id="tool-earth">
    <div class="section-heading"><div><h2>🌍 Planet Earth</h2><p>A few facts about our amazing planet.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <div class="big-number" id="earthNumber">~71%</div>
      <h3 id="earthTitle">Ocean-covered surface</h3>
      <p id="earthText">Roughly 71% of Earth's surface is covered by water.</p>
      <button class="btn primary" onclick="nextEarthFact()">Next Earth fact →</button>
      <p class="muted">Figures are approximate and simplified for fun.</p>
    </div>
  </section>

  <!-- COLOR MIXER -->
  <section class="panel hidden" id="tool-colors">
    <div class="section-heading"><div><h2>🎨 Color Lab</h2><p>Become a color scientist.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <div class="color-box" id="colorPreview"></div>
      <div class="big-number" id="hexValue">#7357FF</div>
      <p class="muted">Your color's HEX code</p>
      <label>Red: <span id="rValue">115</span></label><input type="range" class="field" min="0" max="255" value="115" id="red" oninput="mixColor()">
      <label>Green: <span id="gValue">87</span></label><input type="range" class="field" min="0" max="255" value="87" id="green" oninput="mixColor()">
      <label>Blue: <span id="bValue">255</span></label><input type="range" class="field" min="0" max="255" value="255" id="blue" oninput="mixColor()">
      <button class="btn primary" onclick="copyColor()">Copy color code</button>
      <button class="btn light" onclick="randomColor()">Surprise me 🎲</button>
    </div>
  </section>

  <!-- FACT MACHINE -->
  <section class="panel hidden" id="tool-facts">
    <div class="section-heading"><div><h2>🤯 Fact Machine</h2><p>Feed your curiosity.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <div class="emoji">🧠</div>
      <div class="big-number" style="font-size:35px">Did you know?</div>
      <div class="result" id="randomFact">Tap below for a surprising fact!</div>
      <button class="btn primary" onclick="newFact()">Give me another fact!</button>
    </div>
  </section>

  <!-- REACTION TEST -->
  <section class="panel hidden" id="tool-reaction">
    <div class="section-heading"><div><h2>⚡ Reaction Test</h2><p>How fast are your reflexes?</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <div class="result" id="reactionBox" style="text-align:center;padding:35px 10px;background:#7357ff;color:white">
        <h2 id="reactionTitle">Ready?</h2><p id="reactionText" style="color:white">Tap start, then wait for the screen to turn green.</p>
        <button class="btn" style="background:white;color:#222" id="reactionButton" onclick="reactionAction()">Start test</button>
      </div>
      <p class="muted" id="reactionResult">Your result will appear here.</p>
    </div>
  </section>

  <!-- NUMBER GAME -->
  <section class="panel hidden" id="tool-guess">
    <div class="section-heading"><div><h2>🔢 Guess the Number</h2><p>Find the secret number from 1 to 100.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <div class="big-number">? ? ?</div>
      <p>Make a guess. I'll tell you whether it's too high or too low.</p>
      <div class="rowline"><input class="field" id="guessInput" type="number" min="1" max="100" placeholder="Your guess (1–100)"><button class="btn primary" onclick="makeGuess()">Guess!</button></div>
      <div class="result" id="guessResult">You've got unlimited tries. Good luck!</div>
      <p id="guessCount" class="muted">Guesses: 0</p>
      <button class="btn light" onclick="resetGuess()">New secret number ↻</button>
    </div>
  </section>

  <!-- STORY MACHINE -->
  <section class="panel hidden" id="tool-story">
    <div class="section-heading"><div><h2>✍️ Story Machine</h2><p>Ideas for a tiny adventure.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <p>Every story begins with something unexpected.</p>
      <div class="result" id="storyResult">Your story is waiting to be invented.</div>
      <button class="btn primary" onclick="makeStory()">Create a story idea ✨</button>
      <button class="btn light" onclick="copyStory()">Copy idea</button>
    </div>
  </section>

  <!-- TO-DO LIST -->
  <section class="panel hidden" id="tool-todo">
    <div class="section-heading"><div><h2>📝 Future Me</h2><p>Little steps make big adventures.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool">
      <div class="rowline"><input class="field" id="taskInput" placeholder="Something you want to do..." maxlength="120"><button class="btn primary" onclick="addTask()">Add +</button></div>
      <div id="taskList"></div>
      <button class="btn light" onclick="clearDone()">Remove completed</button>
      <p class="muted">Your list may be saved in this browser on this device.</p>
    </div>
  </section>

  <!-- COIN FLIP -->
  <section class="panel hidden" id="tool-coin">
    <div class="section-heading"><div><h2>🪙 Coin of Destiny</h2><p>Make a decision with a flip.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool" style="text-align:center">
      <div class="big-number" id="coinEmoji" style="font-size:85px">🪙</div>
      <h2 id="coinResult">The coin is ready.</h2>
      <button class="btn primary" onclick="flipCoin()">Flip the coin!</button>
      <p class="muted">It's a random digital coin flip, not a prediction.</p>
    </div>
  </section>

  <!-- CLICKER -->
  <section class="panel hidden" id="tool-clicker">
    <div class="section-heading"><div><h2>🖱️ Button Madness</h2><p>Tap as much as you can in ten seconds.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool" style="text-align:center">
      <div class="big-number" id="clickerScore">0</div>
      <p id="clickerTimer">Ready for ten seconds?</p>
      <button class="btn primary" style="font-size:22px;padding:22px 35px" id="clickerButton" onclick="clickerTap()">TAP!</button>
      <p><button class="btn light" onclick="startClicker()">Start / Restart</button></p>
      <p class="muted">Tap the big button quickly before time runs out.</p>
    </div>
  </section>

  <!-- FORTUNE -->
  <section class="panel hidden" id="tool-fortune">
    <div class="section-heading"><div><h2>🔮 Fortune Cookie</h2><p>A tiny message for your day.</p></div><button class="pill" onclick="closeTools()">✕ Close</button></div>
    <div class="card tool" style="text-align:center">
      <div class="big-number">🥠</div>
      <div class="result" id="fortuneText">Your fortune is tucked inside.</div>
      <button class="btn primary" onclick="newFortune()">Open a fortune</button>
    </div>
  </section>

  <!-- EXTRA EXPERIMENTS -->
  <section class="panel" id="play">
    <div class="section-heading"><div><h2>More tiny joys.</h2><p>Even the smallest things can be fun.</p></div></div>
    <div class="grid">
      <div class="card">
        <span class="emoji">💭</span><h3>Thought of the day</h3>
        <p id="thought">What if clouds were just the sky's dreams?</p>
        <button class="btn light" onclick="newThought()">New thought ↻</button>
      </div>
      <div class="card">
        <span class="emoji">🎲</span><h3>Dice roller</h3>
        <div class="big-number" id="diceNumber">⚄</div>
        <button class="btn light" onclick="rollDice()">Roll dice</button>
      </div>
      <div class="card">
        <span class="emoji">🧮</span><h3>Quick calculator</h3>
        <input class="field" id="calcA" type="number" placeholder="First number">
        <input class="field" id="calcB" type="number" placeholder="Second number">
