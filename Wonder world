  <section class="panel">
    <div class="card tool" style="text-align:center">
      <div class="emoji">🚀</div>
      <h2>You've reached the edge of this little universe.</h2>
      <p>Except there's always another button to press, another question to ask, and another experiment to build.</p>
      <button class="btn primary" onclick="surpriseMe()">Choose a random experiment ✨</button>
      <button class="btn light" onclick="window.scrollTo({top:0,behavior:'smooth'})">Back to the top ↑</button>
    </div>
  </section>
</main>

<footer>
  <div class="logo">wonder<span>lab</span> ✳</div>
  <p>Made for curious minds, enthusiastic clickers, and professional daydreamers.</p>
  <p>An independent learning project inspired by the spirit of playful web experiments.</p>
  <p>© WonderLab — made with HTML, CSS, and JavaScript.</p>
</footer>

<div id="toast" class="hidden" role="status"></div>

<script>
/* =========================================
   WONDERLAB: MAIN WEBSITE ENGINE
========================================= */

let clicks = 0;
let currentCategory = "all";

const tools = [
  "universe","money","earth","colors","facts","reaction",
  "guess","story","todo","coin","clicker","fortune"
];

document.getElementById("visitCount").textContent =
  document.querySelectorAll(".experiment").length;

function safeGet(key, fallback) {
  try {
    const value = localStorage.getItem(key);
    return value === null ? fallback : value;
  } catch (error) {
    return fallback;
  }
}
function safeSet(key, value) {
  try {
    localStorage.setItem(key, value);
    return true;
  } catch (error) {
    return false;
  }
}
function countClick() {
  clicks++;
  document.getElementById("clickCount").textContent = clicks;
}
function toast(message) {
  const el = document.getElementById("toast");
  el.textContent = message;
  el.classList.remove("hidden");
  clearTimeout(window.toastTimer);
  window.toastTimer = setTimeout(() => el.classList.add("hidden"), 2300);
}
function toggleDark() {
  document.body.classList.toggle("dark");
  const dark = document.body.classList.contains("dark");
  document.getElementById("themeBtn").textContent =
    dark ? "☀️ Theme" : "🌙 Theme";
  safeSet("wonder-dark", dark ? "yes" : "no");
}
if (safeGet("wonder-dark", "no") === "yes") {
  document.body.classList.add("dark");
  document.getElementById("themeBtn").textContent = "☀️ Theme";
}

function openTool(name) {
  closeTools();
  const section = document.getElementById("tool-" + name);
  if (!section) return;
  section.classList.remove("hidden");
  section.scrollIntoView({ behavior: "smooth", block: "start" });
  countClick();
}
function closeTools() {
  tools.forEach(name => {
    const section = document.getElementById("tool-" + name);
    if (section) section.classList.add("hidden");
  });
}
function setCategory(category, button) {
  currentCategory = category;
  document.querySelectorAll(".pill").forEach(el => {
    if (el.closest("#explore")) el.classList.remove("active");
  });
  button.classList.add("active");
  filterCards();
}
function filterCards() {
  const search = document.getElementById("search").value.toLowerCase().trim();
  let visible = 0;
  document.querySelectorAll(".experiment").forEach(card => {
    const matchesText = card.innerText.toLowerCase().includes(search);
    const matchesCategory = currentCategory === "all" ||
      card.dataset.category === currentCategory;
    const show = matchesText && matchesCategory;
    card.classList.toggle("hidden", !show);
    if (show) visible++;
  });
  document.getElementById("noResults").classList.toggle("hidden", visible > 0);
}
function surpriseMe() {
  const cards = [...document.querySelectorAll(".experiment")];
  const available = cards.filter(c => !c.classList.contains("hidden"));
  const chosen = available[Math.floor(Math.random() * available.length)];
  if (chosen) chosen.click();
  else {
    setCategory("all", document.querySelector("#explore .pill"));
    const first = document.querySelector(".experiment");
    if (first) first.click();
  }
}

/* =========================================
   SPACE EXPLORER
========================================= */
const planetFacts = {
  Earth: "Our home planet has liquid water on its surface and supports an extraordinary variety of life.",
  Mars: "Mars is a cold, rocky world known for its reddish appearance. Scientists have found evidence that water once flowed there.",
  Jupiter: "Jupiter is the largest planet in our Solar System. Its atmosphere contains a giant storm called the Great Red Spot.",
  Saturn: "Saturn is famous for its beautiful rings, which are made mostly of countless pieces of ice and rocky material.",
  Neptune: "Neptune is a distant, blue ice giant. Winds in its atmosphere can reach extremely high speeds."
};
function planet(name, button) {
  document.querySelectorAll(".planet").forEach(el => el.classList.remove("selected"));
  button.classList.add("selected");
  document.getElementById("planetInfo").innerHTML =
    "<h3>" + name + "</h3>" + planetFacts[name];
  countClick();
}

/* =========================================
   PRETEND MONEY SHOPPING
========================================= */
const startingMoney = 1000000;
let balance = startingMoney;
const purchases = [
  { icon:"🍕", name:"A giant pizza", price:25 },
  { icon:"🎮", name:"A gaming setup", price:2500 },
  { icon:"🚲", name:"A cool bicycle", price:600 },
  { icon:"🏝️", name:"A private island", price:500000 },
  { icon:"🚀", name:"A pretend spaceship", price:150000 },
  { icon:"🏰", name:"A fantasy castle", price:300000 },
  { icon:"🍦", name:"One million ice creams", price:200000 },
  { icon:"🤖", name:"A friendly robot", price:50000 }
];
function formatMoney(n) {
  return "$" + n.toLocaleString("en-US");
}
function renderShop() {
  document.getElementById("balance").textContent = formatMoney(balance);
  document.getElementById("moneyMeter").style.width =
    Math.max(0, Math.min(100, balance / startingMoney * 100)) + "%";
  document.getElementById("shopGrid").innerHTML = purchases.map((item, i) =>
    `<button class="shop-item" onclick="buyItem(${i})">
      <span style="font-size:27px">${item.icon}</span>
      <strong>${item.name}</strong>
      <small>${formatMoney(item.price)}</small>
    </button>`
  ).join("");
}
function buyItem(i) {
  const item = purchases[i];
  if (balance < item.price) {
    document.getElementById("moneyMessage").textContent =
      "Oops! You don't have enough pretend money for " + item.name + ".";
    return;
  }
  balance -= item.price;
  renderShop();
  document.getElementById("moneyMessage").textContent =
    "You bought " + item.name + "! You have " + formatMoney(balance) + " left.";
  countClick();
}
function resetMoney() {
  balance = startingMoney;
  renderShop();
  document.getElementById("moneyMessage").textContent =
    "Fresh fortune! You have one million pretend dollars.";
}
renderShop();

/* =========================================
   EARTH FACT EXPLORER
========================================= */
const earthFacts = [
  ["~71%", "Ocean-covered surface", "Roughly 71% of Earth's surface is covered by water."],
  ["24 hours", "A day, approximately", "Earth rotates once in about 24 hours. The exact length depends on how a day is measured."],
  ["365.25 days", "A trip around the Sun", "Earth takes about 365.25 days to orbit the Sun. Leap years help keep our calendar aligned."],
  ["1 Moon", "Our natural satellite", "Earth has one permanent natural moon, which affects ocean tides."],
  ["7 continents", "A common model", "Many school geography systems teach seven continents, although continent groupings can vary."],
  ["~150 million km", "Average distance to the Sun", "Earth's average distance from the Sun is about 150 million kilometres."]
];
let earthIndex = 0;
function nextEarthFact() {
  earthIndex = (earthIndex + 1) % earthFacts.length;
  const f = earthFacts[earthIndex];
  document.getElementById("earthNumber").textContent = f[0];
  document.getElementById("earthTitle").textContent = f[1];
  document.getElementById("earthText").textContent = f[2];
  countClick();
}

/* =========================================
   COLOR MIXER
========================================= */
function hex(n) {
  return Number(n).toString(16).padStart(2, "0").toUpperCase();
}
function mixColor() {
  const r = +document.getElementById("red").value;
  const g = +document.getElementById("green").value;
  const b = +document.getElementById("blue").value;
  const color = "#" + hex(r) + hex(g) + hex(b);
  document.getElementById("rValue").textContent = r;
  document.getElementById("gValue").textContent = g;
  document.getElementById("bValue").textContent = b;
  document.getElementById("hexValue").textContent = color;
  document.getElementById("colorPreview").style.background = color;
}
function randomColor() {
  ["red","green","blue"].forEach(id => {
    document.getElementById(id).value = Math.floor(Math.random() * 256);
  });
  mixColor();
  countClick();
}
async function copyColor() {
  const color = document.getElementById("hexValue").textContent;
  try {
    await navigator.clipboard.writeText(color);
    toast(color + " copied!");
  } catch (error) {
    toast("Your color is " + color + " — copy it manually.");
  }
}
mixColor();

/* =========================================
   RANDOM FACT MACHINE
========================================= */
const facts = [
  "Octopuses have three hearts.",
  "A group of flamingos is often called a flamboyance.",
  "Honey can remain edible for a very long time when properly sealed and stored.",
  "The fingerprints of koalas can look surprisingly similar to human fingerprints.",
  "Lightning can heat the air around it to temperatures hotter than the surface of the Sun.",
  "A day on Venus is longer than its year when measured using its rotation and orbit periods.",
  "Wombats produce cube-shaped droppings.",
  "Sharks existed before trees appeared on Earth.",
  "The Eiffel Tower can change height slightly as its metal expands and contracts with temperature.",
  "Some bamboo species can grow extremely quickly under suitable conditions.",
  "A typical cumulus cloud can contain a surprisingly large amount of water spread across a huge volume.",
  "There are more possible arrangements of a standard deck of cards than there are seconds in many millions of years."
];
let lastFact = -1;
function newFact() {
  let i;
  do { i = Math.floor(Math.random() * facts.length); }
  while (i === lastFact && facts.length > 1);
  lastFact = i;
  document.getElementById("randomFact").textContent = facts[i];
  countClick();
}

/* =========================================
   REACTION TIME TEST
========================================= */
let reactionState = "idle";
let reactionTimer = null;
let reactionStart = 0;
function reactionAction() {
  const box = document.getElementById("reactionBox");
  const title = document.getElementById("reactionTitle");
  const txt = document.getElementById("reactionText");
  const btn = document.getElementById("reactionButton");
  if (reactionState === "waiting") {
    clearTimeout(reactionTimer);
    reactionState = "early";
    box.style.background = "#e54b66";
    title.textContent = "Too early!";
    txt.textContent = "Wait for green next time.";
    btn.textContent = "Try again";
    return;
  }
  if (reactionState === "ready") {
    const ms = Math.round(performance.now() - reactionStart);
    reactionState = "done";
    box.style.background = "#7357ff";
    title.textContent = ms + " ms";
    txt.textContent = ms < 250 ? "Super quick!" : ms < 400 ? "Nice reflexes!" : "Keep practicing!";
    btn.textContent = "Try again";
    document.getElementById("reactionResult").textContent =
      "Your reaction time: " + ms + " milliseconds.";
    countClick();
    return;
  }
  reactionState = "waiting";
  box.style.background = "#e5a33d";
  title.textContent = "Wait for green...";
  txt.textContent = "Don't tap yet!";
  btn.textContent = "Wait...";
  document.getElementById("reactionResult").textContent = "Get ready...";
  reactionTimer = setTimeout(() => {
    if (reactionState !== "waiting") return;
    reactionState = "ready";
    reactionStart = performance.now();
    box.style.background = "#25a66a";
    title.textContent = "TAP NOW!";
    txt.textContent = "As quickly as you can!";
    btn.textContent = "TAP!";
  }, 1500 + Math.random() * 3500);
}

/* =========================================
   GUESS THE NUMBER
========================================= */
let secretNumber = Math.floor(Math.random() * 100) + 1;
let guesses = 0;
function makeGuess() {
  const input = document.getElementById("guessInput");
  const n = Number(input.value);
  if (!input.value || !Number.isInteger(n) || n < 1 || n > 100) {
    document.getElementById("guessResult").textContent =
      "Enter a whole number from 1 to 100.";
    return;
  }
  guesses++;
  const result = document.getElementById("guessResult");
  if (n === secretNumber) {
    result.textContent = "🎉 Correct! The secret number was " + secretNumber +
      ". You found it in " + guesses + " guesses!";
  } else if (n < secretNumber) {
    result.textContent = "Too low! Try a bigger number.";
  } else {
    result.textContent = "Too high! Try a smaller number.";
  }
  document.getElementById("guessCount").textContent = "Guesses: " + guesses;
  input.value = "";
  countClick();
}
function resetGuess() {
  secretNumber = Math.floor(Math.random() * 100) + 1;
  guesses = 0;
  document.getElementById("guessResult").textContent = "New secret number created. Guess away!";
  document.getElementById("guessCount").textContent = "Guesses: 0";
  document.getElementById("guessInput").value = "";
}

/* =========================================
   STORY MACHINE
========================================= */
const storyWho = ["a sleepy dragon","a robot who loves flowers","a kid with a magic backpack","a talking moon","a penguin detective","an invisible superhero","a tiny alien chef"];
const storyWhere = ["on a floating island","inside a giant library","at the edge of the universe","in a city made of candy","under the ocean","in a school for wizards","on a train to nowhere"];
const storyWhat = ["discovers a mysterious key","accidentally changes the weather","finds a door in the sky","must solve a very silly mystery","receives a letter from the future","starts a dance competition","finds a map drawn by a cat"];
function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
let latestStory = "";
function makeStory() {
  latestStory = "One day, " + pick(storyWho) + " " + pick(storyWhere) +
    " and " + pick(storyWhat) + ". What happens next? Only you can decide!";
  document.getElementById("storyResult").textContent = latestStory;
  countClick();
}
async function copyStory() {
  if (!latestStory) { toast("Create a story first!"); return; }
  try {
    await navigator.clipboard.writeText(latestStory);
    toast("Story idea copied!");
  } catch (error) {
    toast("Select and copy your story idea.");
  }
}

/* =========================================
   TO-DO LIST
========================================= */
let tasks = [];
try {
  const parsedTasks = JSON.parse(safeGet("wonder-tasks", "[]"));
  if (Array.isArray(parsedTasks)) tasks = parsedTasks;
} catch (error) { tasks = []; }

function saveTasks() {
  safeSet("wonder-tasks", JSON.stringify(tasks));
}
function renderTasks() {
  const list = document.getElementById("taskList");
  list.innerHTML = "";
  tasks.forEach((task, index) => {
    const row = document.createElement("div");
    row.className = "task" + (task.done ? " done" : "");
    const check = document.createElement("input");
    check.type = "checkbox";
    check.checked = !!task.done;
    check.setAttribute("aria-label", "Mark task complete");
    check.addEventListener("change", () => {
      tasks[index].done = check.checked;
      saveTasks();
      renderTasks();
    });
    const label = document.createElement("span");
    label.textContent = task.text;
    const remove = document.createElement("button");
    remove.textContent = "✕";
    remove.setAttribute("aria-label", "Delete task");
    remove.addEventListener("click", () => {
      tasks.splice(index, 1);
      saveTasks();
      renderTasks();
    });
    row.append(check, label, remove);
    list.appendChild(row);
  });
}
function addTask() {
  const input = document.getElementById("taskInput");
  const text = input.value.trim();
  if (!text) { toast("Write a task first!"); return; }
  tasks.push({ text, done: false });
  input.value = "";
  saveTasks();
  renderTasks();
  countClick();
}
function clearDone() {
  tasks = tasks.filter(task => !task.done);
  saveTasks();
  renderTasks();
}
document.getElementById("taskInput").addEventListener("keydown", event => {
  if (event.key === "Enter") addTask();
});
renderTasks();

/* =========================================
   COIN OF DESTINY
========================================= */
function flipCoin() {
  const heads = Math.random() < .5;
  document.getElementById("coinEmoji").textContent = heads ? "👑" : "🦅";
  document.getElementById("coinResult").textContent = heads ? "HEADS!" : "TAILS!";
  countClick();
}

/* =========================================
   TEN-SECOND CLICKER
========================================= */
let clickerActive = false;
let clickerScore = 0;
let clickerEnd = 0;
let clickerInterval = null;
function startClicker() {
  clearInterval(clickerInterval);
  clickerScore = 0;
  clickerActive = true;
  clickerEnd = Date.now() + 10000;
  document.getElementById("clickerScore").textContent = "0";
  document.getElementById("clickerTimer").textContent = "10 seconds left!";
  document.getElementById("clickerButton").textContent = "TAP!";
  clickerInterval = setInterval(() => {
    const left = Math.max(0, (clickerEnd - Date.now()) / 1000);
    document.getElementById("clickerTimer").textContent =
      left.toFixed(1) + " seconds left!";
    if (left <= 0) {
      clearInterval(clickerInterval);
      clickerActive = false;
      document.getElementById("clickerTimer").textContent =
        "Time's up! Your score: " + clickerScore;
      document.getElementById("clickerButton").textContent = "Start again";
    }
  }, 100);
}
function clickerTap() {
  if (!clickerActive) { startClicker(); return; }
  clickerScore++;
  document.getElementById("clickerScore").textContent = clickerScore;
}

/* =========================================
   FORTUNE COOKIE
========================================= */
const fortunes = [
  "A small idea today might become a big adventure tomorrow.",
  "Your next great discovery may begin with a question.",
  "You are allowed to be a beginner at something wonderful.",
  "A little kindness can travel further than you imagine.",
  "The best time to learn something new is when you're curious.",
  "Your future self will thank you for one small step today.",
  "Sometimes the most interesting path is the one you didn't plan.",
  "Keep asking why. The world has fascinating answers."
];
function newFortune() {
  document.getElementById("fortuneText").textContent = pick(fortunes);
  countClick();
}

/* =========================================
   MORE LITTLE EXPERIMENTS
========================================= */
const thoughts = [
  "What if clouds were just the sky's dreams?",
  "Somewhere, a future version of you is cheering you on.",
  "Every expert was once a beginner with a question.",
  "The universe is old, but your ideas can still be new.",
  "A tiny experiment can lead to a huge discovery.",
  "What would your pet say if it could review your day?",
  "Maybe boredom is your imagination asking for a new job."
];
function newThought() {
  document.getElementById("thought").textContent = pick(thoughts);
}
function rollDice() {
  const n = Math.floor(Math.random() * 6) + 1;
  document.getElementById("diceNumber").textContent =
    ["⚀","⚁","⚂","⚃","⚄","⚅"][n-1];
  countClick();
}
function calculate(op) {
  const a = Number(document.getElementById("calcA").value);
  const b = Number(document.getElementById("calcB").value);
  if (document.getElementById("calcA").value === "" ||
      document.getElementById("calcB").value === "") {
    document.getElementById("calcResult").textContent = "Enter both numbers first.";
    return;
  }
  if (op === "/" && b === 0) {
    document.getElementById("calcResult").textContent = "You cannot divide by zero.";
    return;
  }
  let answer;
  if (op === "+") answer = a + b;
  if (op === "-") answer = a - b;
  if (op === "*") answer = a * b;
  if (op === "/") answer = a / b;
  document.getElementById("calcResult").textContent = "Answer: " + answer;
}
function rainbow() {
  const hue = Math.floor(Math.random() * 360);
  document.getElementById("rainbowBox").style.background =
    `linear-gradient(135deg,hsl(${hue},90%,65%),hsl(${(hue+120)%360},90%,65%),hsl(${(hue+240)%360},90%,65%))`;
  countClick();
}
let breathStep = 0;
function breathe() {
  breathStep++;
  const steps = [
    ["Breathe in","Gently breathe in, without forcing it."],
    ["Breathe out","Slowly breathe out and relax your shoulders."],
    ["Pause","Rest for a moment. Continue whenever comfortable."]
  ];
  const step = steps[breathStep % steps.length];
  document.getElementById("breathText").textContent = step[0];
  document.getElementById("breathHelp").textContent = step[1];
}
const suggestions = [
  "Learn one new fact about space.",
  "Draw an imaginary animal.",
  "Build a tiny website feature.",
  "Ask someone an interesting question.",
  "Invent a silly game.",
  "Write a three-sentence story.",
  "Go outside and notice something new.",
  "Make a color you've never used before."
];
function pickForMe() {
  document.getElementById("pickResult").textContent = pick(suggestions);
}

/* =========================================
   PERSONAL NOTE
========================================= */
function saveNote() {
  const nickname = document.getElementById("nickname").value.trim();
  const message = document.getElementById("message").value.trim();
  const data = { nickname, message };
  const saved = safeSet("wonder-note", JSON.stringify(data));
  document.getElementById("noteResult").textContent =
    (nickname ? "Hey, " + nickname + "! " : "") +
    (saved ? "Your note has been saved on this device." :
      "Your note is here for now, but this browser could not save it.");
  countClick();
}
function loadNote() {
  try {
    const data = JSON.parse(safeGet("wonder-note", "{}"));
    document.getElementById("nickname").value = data.nickname || "";
    document.getElementById("message").value = data.message || "";
    document.getElementById("noteResult").textContent =
      data.message || data.nickname ? "Your saved note has been loaded." :
      "No saved note found yet.";
  } catch (error) {
    document.getElementById("noteResult").textContent =
      "Couldn't read a saved note in this browser.";
  }
}

/* Enter key shortcuts for simple games */
document.getElementById("guessInput").addEventListener("keydown", event => {
  if (event.key === "Enter") makeGuess();
});
</script>
